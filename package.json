{
  "name": "base",
  "version": "0.0.0",
  "description": "",
  "author": "Yaroslav Pavliuk",
  "license": "",
  "private": true,
  "packageManager": "yarn@3.6.0",
  "bugs": {
    "url": "https://github.com/easylayer/base/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/easylayer/base.git"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "apps/*/*",
      "packages/*",
      "packages/*/*",
      "e2e-tests/*",
      "e2e-tests/*/*"
    ]
  },
  "scripts": {
    "clear": "lerna run clear:dist && lerna run clear:node_modules && rimraf node_modules && yarn cache clean",
    "clear:node_modules": "lerna run  clear:node_modules && rimraf node_modules",
    "clear:dist": "lerna run clear:dist",
    "build:packages": "lerna run --stream build --ignore example-app",
    "start:dev:example-app": "cd ./apps/example-app && DEBUG=y yarn start:dev",
    "test:unit": "lerna run --stream test:unit",
    "test:e2e": "lerna run --stream test:e2e",
    "lint": "lerna run --stream lint",
    "lint:fix": "lerna run --stream lint:fix",
    "postinstall": "husky install",
    "pre-commit": "lerna run lint",
    "pre-push": "lerna run test:unit",
    "commit": "cz",
    "generate-quickstart-app": "node ./packages/cli/create-easylayer-app/bin/index.js --quickstart",
    "generate-source-docs": "typedoc",
    "generate-api-docs": "lerna run --stream generate-api-docs --",
    "generate-config-docs": "lerna run --stream generate-config-docs --"
  },
  "devDependencies": {
    "@commitlint/cli": "18.4.3",
    "@commitlint/config-conventional": "18.4.3",
    "@tsconfig/node18": "18.2.2",
    "@typescript-eslint/eslint-plugin": "6.13.2",
    "@typescript-eslint/parser": "6.13.2",
    "commitizen": "4.3.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "8.55.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.0.1",
    "husky": "8.0.3",
    "lerna": "8.0.0",
    "prettier": "3.1.1",
    "rimraf": "5.0.5",
    "typedoc": "0.25.6",
    "typescript": "5.3.3"
  },
  "devEngines": {
    "node": ">=18.0.0 <=20.x.x",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "sqlite": "5.1.1"
  }
}
