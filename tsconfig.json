{
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "NodeNext",
    "target": "es2022",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noImplicitThis": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@easylayer/cli/*": ["packages/cli/*/src"],
      "@easylayer/core/*": ["packages/core/*/src"],
      "@easylayer/components/*": ["packages/components/*/src"],
      "@easylayer/*": ["packages/*/src"]
    }
  }
}