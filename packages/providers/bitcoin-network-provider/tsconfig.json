{
  "extends": "@easylayer/utils/tsconfigs/base.config.json",
  "compilerOptions": {
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "composite": true,
    "typeRoots": [
      "./src/@types",
      "./node_modules/@types",
      "../../node_modules/@types"
    ],  
  },
  "include": ["src"],
  "exclude": ["node_modules"],
}